# Copy to .env and fill in. This file is committed, so keep real keys out of it.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional. Defaults to gpt-5-mini.
OPENAI_MODEL=gpt-5-mini

# Invite code required to sign up. Set this before exposing the app publicly:
# every account that gets created spends your API credits.
# Empty means open registration, which is fine on localhost only.
APP_PASSWORD=
